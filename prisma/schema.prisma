generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  kyc           KYCRecord?
  wallets       Wallet[]
  investments   Investment[]
  transactions  Transaction[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model KYCRecord {
  id              String     @id @default(cuid())
  userId          String     @unique @map("user_id")
  status          KYCStatus  @default(PENDING)
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  dateOfBirth     DateTime?  @map("date_of_birth")
  nationality     String?
  idType          String?    @map("id_type")
  idNumber        String?    @map("id_number")
  idDocumentUrl   String?    @map("id_document_url")
  proofOfAddressUrl String?  @map("proof_of_address_url")
  selfieUrl       String?    @map("selfie_url")
  address         String?
  city            String?
  country         String?
  postalCode      String?    @map("postal_code")
  phoneNumber     String?    @map("phone_number")
  riskLevel       RiskLevel  @default(LOW) @map("risk_level")
  submittedAt     DateTime?  @map("submitted_at")
  reviewedAt      DateTime?  @map("reviewed_at")
  reviewedBy      String?    @map("reviewed_by")
  notes           String?
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_records")
}

model Wallet {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  address       String        @unique
  chainId       Int           @map("chain_id")
  chain         String
  type          WalletType    @default(EOA)
  isPrimary     Boolean       @default(false) @map("is_primary")
  isVerified    Boolean       @default(false) @map("is_verified")
  verifiedAt    DateTime?     @map("verified_at")
  balance       Decimal       @default(0) @db.Decimal(18, 8)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@map("wallets")
}

model Property {
  id              String          @id @default(cuid())
  title           String
  description     String          @db.Text
  slug            String          @unique
  type            PropertyType
  status          PropertyStatus  @default(DRAFT)
  location        String
  city            String
  country         String
  latitude        Decimal?        @db.Decimal(10, 8)
  longitude       Decimal?        @db.Decimal(11, 8)
  totalValue      Decimal         @map("total_value") @db.Decimal(18, 2)
  tokenPrice      Decimal         @map("token_price") @db.Decimal(18, 6)
  totalTokens     Int             @map("total_tokens")
  availableTokens Int           @map("available_tokens")
  minInvestment   Decimal         @map("min_investment") @db.Decimal(18, 2)
  expectedReturn  Decimal?        @map("expected_return") @db.Decimal(5, 2)
  rentalYield     Decimal?        @map("rental_yield") @db.Decimal(5, 2)
  images          String[]
  documents       String[]
  features        String[]
  tokenAddress    String?         @map("token_address")
  contractAddress String?         @map("contract_address")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  publishedAt     DateTime?       @map("published_at")

  investments     Investment[]
  payouts         Payout[]

  @@map("properties")
}

model Investment {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  propertyId      String            @map("property_id")
  tokens          Int
  amount          Decimal           @db.Decimal(18, 2)
  tokenPrice      Decimal           @map("token_price") @db.Decimal(18, 6)
  status          InvestmentStatus  @default(PENDING)
  txHash          String?           @map("tx_hash")
  walletAddress   String?           @map("wallet_address")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  transactions    Transaction[]

  @@map("investments")
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  investmentId    String?           @map("investment_id")
  walletId        String?           @map("wallet_id")
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  amount          Decimal           @db.Decimal(18, 2)
  tokenAmount     Int?              @map("token_amount")
  fee             Decimal?          @db.Decimal(18, 6)
  txHash          String?           @map("tx_hash")
  fromAddress     String?           @map("from_address")
  toAddress       String?           @map("to_address")
  metadata        Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  investment      Investment?       @relation(fields: [investmentId], references: [id])
  wallet          Wallet?           @relation(fields: [walletId], references: [id])

  @@map("transactions")
}

model Payout {
  id              String        @id @default(cuid())
  propertyId      String        @map("property_id")
  amount          Decimal       @db.Decimal(18, 2)
  type            PayoutType
  periodStart     DateTime      @map("period_start")
  periodEnd       DateTime      @map("period_end")
  distributedAt   DateTime?     @map("distributed_at")
  txHash          String?       @map("tx_hash")
  status          PayoutStatus  @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at")

  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  distributions   Distribution[]

  @@map("payouts")
}

model Distribution {
  id              String    @id @default(cuid())
  payoutId        String    @map("payout_id")
  userId          String    @map("user_id")
  amount          Decimal   @db.Decimal(18, 2)
  tokens          Int
  txHash          String?   @map("tx_hash")
  distributedAt   DateTime? @map("distributed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  payout          Payout    @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@map("distributions")
}

model Notification {
  id          String            @id @default(cuid())
  userId      String            @map("user_id")
  type        NotificationType
  title       String
  message     String
  read        Boolean           @default(false)
  metadata    Json?
  createdAt   DateTime          @default(now()) @map("created_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id          String    @id @default(cuid())
  userId      String?   @map("user_id")
  action      String
  entity      String
  entityId    String?   @map("entity_id")
  oldValue    Json?     @map("old_value")
  newValue    Json?     @map("new_value")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User?     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum UserRole {
  USER
  INVESTOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  BANNED
}

enum KYCStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum WalletType {
  EOA
  SMART_CONTRACT
  MULTISIG
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  RETAIL
  MIXED_USE
  HOSPITALITY
  LAND
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  FUNDED
  CLOSED
  SUSPENDED
}

enum InvestmentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
}

enum TransactionType {
  INVESTMENT
  WITHDRAWAL
  DEPOSIT
  PAYOUT
  FEE
  REFUND
  TRANSFER
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum PayoutType {
  RENTAL
  APPRECIATION
  DIVIDEND
}

enum PayoutStatus {
  PENDING
  PROCESSING
  DISTRIBUTED
  FAILED
}

enum NotificationType {
  INVESTMENT
  PAYOUT
  KYC
  SYSTEM
  PRICE_ALERT
  SECURITY
}
