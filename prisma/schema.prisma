generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())

  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?
  phone         String?
  address       String?
  password      String?
  role          UserRole  @default(USER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  kyc           KYCRecord?
  wallets       Wallet[]
  investments   Investment[]
  transactions  Transaction[]
  notifications Notification[]
  auditLogs     AuditLog[]
  maintenanceRequests MaintenanceRequest[]
  userNotificationSettings UserNotificationSettings?
  secondaryOrders SecondaryMarketOrder[]

  @@map("users")
}


model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model KYCRecord {
  id                String     @id @default(cuid())
  userId            String     @unique @map("user_id")
  status            KYCStatus  @default(PENDING)
  firstName         String     @map("first_name")
  lastName          String     @map("last_name")
  dateOfBirth       DateTime?  @map("date_of_birth")
  nationality       String?    @default("Nigerian")
  idType            LocalIDType @default(BVN) @map("id_type")
  idNumber          String?    @map("id_number") // Hashed or encrypted in application logic
  ninNumber         String?    @map("nin_number") // Optional secondary document entry
  idDocumentUrl     String?    @map("id_document_url")
  proofOfAddressUrl String?    @map("proof_of_address_url")
  selfieUrl         String?    @map("selfie_url")
  address           String?
  city              String?
  state             String?    @default("Lagos") // Local territory context maps
  country           String?    @default("Nigeria")
  postalCode        String?    @map("postal_code")
  phoneNumber       String?    @map("phone_number")
  riskLevel         RiskLevel  @default(LOW) @map("risk_level")
  investorCategory  String?    @default("RETAIL") @map("investor_category") // RETAIL, HIGH_NET_WORTH, INSTITUTIONAL
  investmentGoals   String[]   @map("investment_goals")
  submittedAt       DateTime?  @map("submitted_at")
  reviewedAt        DateTime?  @map("reviewed_at")
  reviewedBy        String?    @map("reviewed_by")
  notes             String?
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_records")
}

model Wallet {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  address       String        @unique
  chainId       Int           @map("chain_id")
  chain         String
  type          WalletType    @default(EOA)
  isPrimary     Boolean       @default(false) @map("is_primary")
  isVerified    Boolean       @default(false) @map("is_verified")
  verifiedAt    DateTime?     @map("verified_at")
  balance       Decimal       @default(0) @db.Decimal(18, 8)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@map("wallets")
}

model Property {
  id                     String             @id @default(cuid())
  title                  String
  description            String             @db.Text
  slug                   String             @unique
  type                   PropertyType
  status                 PropertyStatus     @default(DRAFT)
  developmentStatus      DevelopmentStatus  @default(EXISTING_STRUCTURE) @map("development_status")
  completionPercentage   Decimal            @default(100.00) @map("completion_percentage") @db.Decimal(5, 2)
  location               String
  city                   String
  state                  String             @default("Lagos")
  country                String             @default("Nigeria")
  latitude               Decimal?           @db.Decimal(10, 8)
  longitude              Decimal?           @db.Decimal(11, 8)
  
  // Dual-Currency Value Layer to prevent cross-rate conversion degradation
  totalValueUSD          Decimal            @map("total_value_usd") @db.Decimal(18, 2)
  totalValueNGN          Decimal            @map("total_value_ngn") @db.Decimal(18, 2)
  tokenPriceUSD          Decimal            @map("token_price_usd") @db.Decimal(18, 6)
  tokenPriceNGN          Decimal            @map("token_price_ngn") @db.Decimal(18, 2)
  
  totalTokens            Int                @map("total_tokens")
  availableTokens        Int                @map("available_tokens")
  minInvestmentUSD       Decimal            @map("min_investment_usd") @db.Decimal(18, 2)
  
  expectedReturn         Decimal?           @map("expected_return") @db.Decimal(5, 2)
  rentalYield            Decimal?           @map("rental_yield") @db.Decimal(5, 2)
  images                 String[]
  documents              String[]
  features               String[]
  tokenAddress           String?            @map("token_address")
  contractAddress        String?            @map("contract_address")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  publishedAt            DateTime?          @map("published_at")

  investments            Investment[]
  payouts                Payout[]
  milestones             ConstructionMilestone[]
  tenants                PropertyTenant[]
  maintenanceRequests    MaintenanceRequest[]
  secondaryOrders        SecondaryMarketOrder[]
  management             PropertyManagement?

  @@map("properties")
}

model ConstructionMilestone {
  id              String           @id @default(cuid())
  propertyId      String           @map("property_id")
  title           String
  description     String           @db.Text
  percentageValue Decimal          @map("percentage_value") @db.Decimal(5, 2) // Contribution to overall project
  status          MilestoneStatus  @default(PENDING)
  estimatedDate   DateTime         @map("estimated_date")
  completedAt     DateTime?        @map("completed_at")
  evidenceImages  String[]         @map("evidence_images")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("construction_milestones")
}

model Investment {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  propertyId      String            @map("property_id")
  tokens          Int
  amountUSD       Decimal           @map("amount_usd") @db.Decimal(18, 2)
  amountNGN       Decimal           @map("amount_ngn") @db.Decimal(18, 2)
  tokenPriceUSD   Decimal           @map("token_price_usd") @db.Decimal(18, 6)
  status          InvestmentStatus  @default(PENDING)
  txHash          String?           @map("tx_hash")
  walletAddress   String?           @map("wallet_address")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  transactions    Transaction[]

  @@map("investments")
}

model Transaction {
  id                String            @id @default(cuid())
  userId            String            @map("user_id")
  investmentId      String?           @map("investment_id")
  walletId          String?           @map("wallet_id")
  type              TransactionType
  status            TransactionStatus @default(PENDING)
  paymentGateway    PaymentGateway    @default(BLOCKCHAIN) @map("payment_gateway")
  gatewayReference  String?           @unique @map("gateway_reference") // Custom tracker ID for Paystack/Flutterwave/BankTransfer references
  amountUSD         Decimal           @map("amount_usd") @db.Decimal(18, 2)
  amountNGN         Decimal           @map("amount_ngn") @db.Decimal(18, 2)
  tokenAmount       Int?              @map("token_amount")
  feeUSD            Decimal?          @map("fee_usd") @db.Decimal(18, 6)
  txHash            String?           @map("tx_hash")
  fromAddress       String?           @map("from_address")
  toAddress         String?           @map("to_address")
  bankName          String?           @map("bank_name") // For tracking virtual allocations (Opay, Moniepoint, etc.)
  accountNumber     String?           @map("account_number")
  metadata          Json?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  investment        Investment?       @relation(fields: [investmentId], references: [id])
  wallet            Wallet?           @relation(fields: [walletId], references: [id])

  @@map("transactions")
}

model PropertyTenant {
  id              String        @id @default(cuid())
  propertyId      String        @map("property_id")
  tenantName      String        @map("tenant_name")
  leaseStart      DateTime      @map("lease_start")
  leaseEnd        DateTime      @map("lease_end")
  rentAmountNGN   Decimal       @map("rent_amount_ngn") @db.Decimal(18, 2)
  occupancyStatus String        @default("ACTIVE") @map("occupancy_status")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_tenants")
}

model MaintenanceRequest {
  id              String            @id @default(cuid())
  propertyId      String            @map("property_id")
  userId          String            @map("user_id")
  title           String
  description     String            @db.Text
  priority        PriorityLevel     @default(MEDIUM)
  status          MaintenanceStatus @default(REPORTED)
  scheduledDate   DateTime?         @map("scheduled_date")
  estimatedCost   Decimal?          @map("estimated_cost") @db.Decimal(18, 2)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("maintenance_requests")
}

model Payout {
  id              String        @id @default(cuid())
  propertyId      String        @map("property_id")
  amountUSD       Decimal       @map("amount_usd") @db.Decimal(18, 2)
  amountNGN       Decimal       @map("amount_ngn") @db.Decimal(18, 2)
  type            PayoutType
  periodStart     DateTime      @map("period_start")
  periodEnd       DateTime      @map("period_end")
  distributedAt   DateTime?     @map("distributed_at")
  txHash          String?       @map("tx_hash")
  status          PayoutStatus  @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at")

  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  distributions   Distribution[]

  @@map("payouts")
}

model Distribution {
  id              String    @id @default(cuid())
  payoutId        String    @map("payout_id")
  userId          String    @map("user_id")
  amountUSD       Decimal   @map("amount_usd") @db.Decimal(18, 2)
  amountNGN       Decimal   @map("amount_ngn") @db.Decimal(18, 2)
  tokens          Int
  txHash          String?   @map("tx_hash")
  distributedAt   DateTime? @map("distributed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  payout          Payout    @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@map("distributions")
}

model SecondaryMarketOrder {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  propertyId      String            @map("property_id")
  type            OrderType
  priceUSD        Decimal           @map("price_usd") @db.Decimal(18, 6)
  priceNGN        Decimal           @map("price_ngn") @db.Decimal(18, 2)
  quantity        Int
  filledQuantity  Int               @default(0) @map("filled_quantity")
  status          OrderStatus       @default(OPEN)
  expiresAt       DateTime?         @map("expires_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("secondary_market_orders")
}

model PropertyManagement {
  id              String            @id @default(cuid())
  propertyId      String            @unique @map("property_id")
  managerId       String            @map("manager_id")
  occupancyRate   Decimal           @default(0) @map("occupancy_rate") @db.Decimal(5, 2)
  totalUnits      Int               @default(0) @map("total_units")
  occupiedUnits   Int               @default(0) @map("occupied_units")
  monthlyRevenue  Decimal           @default(0) @map("monthly_revenue") @db.Decimal(18, 2)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_management")
}

model Notification {
  id          String            @id @default(cuid())
  userId      String            @map("user_id")
  type        NotificationType
  title       String
  message     String
  read        Boolean           @default(false)
  metadata    Json?
  createdAt   DateTime          @default(now()) @map("created_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model UserNotificationSettings {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")

  emailDrawdown     Boolean  @default(true)  @map("email_drawdown")
  smsSecondaryMatch Boolean  @default(false) @map("sms_secondary_match")
  marketingUpdates  Boolean  @default(true)  @map("marketing_updates")
  twoFactorEnforced Boolean  @default(true)  @map("two_factor_enforced")

  updatedAt         DateTime @updatedAt @map("updated_at")
  createdAt         DateTime @default(now()) @map("created_at")

  // Relation is intentionally unidirectional to match current User model.
  // If you add the opposite relation field on `User`, Prisma can enforce bidirectional relations.
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)



  @@map("user_notification_settings")
}



model AuditLog {
  id          String    @id @default(cuid())
  userId      String?   @map("user_id")
  action      String
  entity      String
  entityId    String?   @map("entity_id")
  oldValue    Json?     @map("old_value")
  newValue    Json?     @map("new_value")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User?     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum UserRole {
  USER
  INVESTOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  BANNED
}

enum KYCStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum LocalIDType {
  BVN
  NIN
  PASSPORT
  VOTERS_CARD
  DRIVERS_LICENSE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum WalletType {
  EOA
  SMART_CONTRACT
  MULTISIG
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  RETAIL
  MIXED_USE
  HOSPITALITY
  LAND
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  FUNDED
  CLOSED
  SUSPENDED
}

enum DevelopmentStatus {
  UNDER_CONSTRUCTION
  EXISTING_STRUCTURE
  PHASED_DEVELOPMENT
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MaintenanceStatus {
  REPORTED
  SCHEDULED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum InvestmentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
}

enum TransactionType {
  INVESTMENT
  WITHDRAWAL
  DEPOSIT
  PAYOUT
  FEE
  REFUND
  TRANSFER
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum PaymentGateway {
  BLOCKCHAIN
  PAYSTACK
  FLUTTERWAVE
  BANK_TRANSFER
  OPAY
  PALMPAY
  MONIEPOINT
}

enum PayoutType {
  RENTAL
  APPRECIATION
  DIVIDEND
}

enum PayoutStatus {
  PENDING
  PROCESSING
  DISTRIBUTED
  FAILED
}

enum NotificationType {
  INVESTMENT
  PAYOUT
  KYC
  SYSTEM
  PRICE_ALERT
  SECURITY
}

enum OrderType {
  BUY
  SELL
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  EXPIRED
}
