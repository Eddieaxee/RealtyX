generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?
  role          String    @default("USER")
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  investments   Investment[]
  kyc           Kyc?

  @@map("users")
}

model Kyc {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  status      String   @default("PENDING")
  firstName   String?  @map("first_name")
  lastName    String?  @map("last_name")
  dateOfBirth DateTime? @map("date_of_birth")
  phoneNumber String?  @map("phone_number")
  address     String?
  country     String?
  idType      String?  @map("id_type")
  idNumber    String?  @map("id_number")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc")
}

model Property {
  id                   String   @id @default(cuid())
  title                String
  description          String?
  slug                 String   @unique
  type                 String   @default("RESIDENTIAL")
  status               String   @default("AVAILABLE")
  developmentStatus    String   @default("COMPLETED") @map("development_status")
  completionPercentage Float    @default(0) @map("completion_percentage")
  location             String?
  city                 String?
  state                String?
  country              String   @default("Nigeria")
  lat                  Float?
  lng                  Float?
  priceUSD             Float    @default(0) @map("price_usd")
  priceNGN             Float    @default(0) @map("price_ngn")
  totalTokens          Int      @default(0) @map("total_tokens")
  availableTokens      Int      @default(0) @map("available_tokens")
  tokenPriceUSD        Float    @default(0) @map("token_price_usd")
  tokenPriceNGN        Float    @default(0) @map("token_price_ngn")
  expectedReturn       Float?   @map("expected_return")
  rentalYield          Float?   @map("rental_yield")
  images               String?
  features             String?
  documents            String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  investments Investment[]

  @@map("properties")
}

model Investment {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  propertyId    String   @map("property_id")
  tokens        Int
  amountUSD     Float    @map("amount_usd")
  amountNGN     Float    @map("amount_ngn")
  status        String   @default("PENDING")
  paymentMethod String?  @map("payment_method")
  txReference   String?  @map("tx_reference")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@map("investments")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String?
  type      String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}