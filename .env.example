# ============================================================
# RealtyX - Platform Environment Configuration
# ============================================================

# ============================================================
# 1. DATABASE
# ============================================================
# SQLite (development)
DATABASE_URL="file:./dev.db"
# PostgreSQL (production) - uncomment and configure:
# DATABASE_URL="postgresql://user:password@localhost:5432/realtyx?schema=public"
# DATABASE_URL="postgresql://user:password@aws-rds-endpoint:5432/realtyx?sslmode=require"

# ============================================================
# 2. NEXT AUTH / AUTHENTICATION
# ============================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-auth-secret-here-change-in-production"

# ============================================================
# 3. OAUTH PROVIDERS
# ============================================================
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"

APPLE_CLIENT_ID="your-apple-client-id"
APPLE_CLIENT_SECRET="your-apple-client-secret"

# ============================================================
# 4. PAYMENT GATEWAYS (FinTech / Multi-Rail Payments)
# ============================================================
# --- Paystack (Nigeria) ---
PAYSTACK_SECRET_KEY="sk_live_xxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_live_xxxxxxxxxxxxx"

# --- Flutterwave (Pan-Africa) ---
FLUTTERWAVE_SECRET_KEY="FLWSECK-xxxxxxxxxxxxx"
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK-xxxxxxxxxxxxx"

# --- OPay (Nigeria) ---
OPAY_MERCHANT_ID="your-opay-merchant-id"
OPAY_PUBLIC_KEY="your-opay-public-key"
OPAY_SECRET_KEY="your-opay-secret-key"

# --- SpendEx (Nigeria) ---
SPENDEX_API_KEY="your-spendex-api-key"

# --- PayPal (International) ---
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_MODE="sandbox"  # or "live"

# ============================================================
# 5. EMAIL / COMMUNICATIONS (SendGrid)
# ============================================================
SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxx"
SENDGRID_FROM_EMAIL="noreply@realtyx.io"
SENDGRID_FROM_NAME="RealtyX"

# SendGrid Dynamic Template IDs
SENDGRID_TEMPLATE_WELCOME="d-welcome-template-id"
SENDGRID_TEMPLATE_KYC_APPROVED="d-kyc-approved-template-id"
SENDGRID_TEMPLATE_KYC_REJECTED="d-kyc-rejected-template-id"
SENDGRID_TEMPLATE_INVESTMENT="d-investment-template-id"
SENDGRID_TEMPLATE_PROPERTY_CREATED="d-property-created-template-id"
SENDGRID_TEMPLATE_DIVIDEND="d-dividend-template-id"
SENDGRID_TEMPLATE_PASSWORD_RESET="d-password-reset-template-id"
SENDGRID_TEMPLATE_VERIFICATION="d-verification-template-id"
SENDGRID_TEMPLATE_LOGIN_ALERT="d-login-alert-template-id"
SENDGRID_TEMPLATE_WITHDRAWAL="d-withdrawal-template-id"

# ============================================================
# 6. SMS NOTIFICATIONS (Termii - Nigeria)
# ============================================================
TERMII_API_KEY="TLxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TERMII_SENDER_ID="RealtyX"

# ============================================================
# 7. BLOCKCHAIN / WEB3 (RWA Tokenization)
# ============================================================
# --- WalletConnect (required for RainbowKit) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your-walletconnect-cloud-project-id"

# --- Deployment Chain ---
NEXT_PUBLIC_CHAIN_ID="137"  # 137 = Polygon Mainnet, 80001 = Mumbai Testnet
NEXT_PUBLIC_RPC_URL="https://polygon-mainnet.infura.io/v3/your-project-id"

# --- Smart Contract Addresses ---
NEXT_PUBLIC_REALTYX_PLATFORM_ADDRESS="0x..."
NEXT_PUBLIC_REALTYX_TOKEN_ADDRESS="0x..."

# --- Wallet / Private Key (Admin) ---
ADMIN_WALLET_PRIVATE_KEY="0x..."
ADMIN_WALLET_ADDRESS="0x..."

# --- IPFS / Metadata Storage ---
NEXT_PUBLIC_IPFS_GATEWAY="https://ipfs.io/ipfs/"
PINATA_API_KEY="your-pinata-api-key"
PINATA_SECRET_KEY="your-pinata-secret-key"

# ============================================================
# 8. EXCHANGE RATE API
# ============================================================
EXCHANGE_RATE_API_KEY="your-exchangerate-api-key"

# ============================================================
# 9. KYC / COMPLIANCE PROVIDERS
# ============================================================
# --- Identity Verification (e.g. IdentityPass, Prembly, SmileID) ---
KYC_PROVIDER_API_KEY="your-kyc-provider-key"
KYC_PROVIDER_SECRET="your-kyc-provider-secret"

# --- AML / Sanctions Screening ---
AML_PROVIDER_API_KEY="your-aml-provider-key"

# ============================================================
# 10. FILE STORAGE / UPLOADS
# ============================================================
# UploadThing for file uploads
UPLOADTHING_SECRET="sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
UPLOADTHING_APP_ID="xxxxxxxx"

# ============================================================
# 11. AI / OPENAI
# ============================================================
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ============================================================
# 12. REDIS (Caching & Rate Limiting)
# ============================================================
REDIS_URL="redis://localhost:6379"

# ============================================================
# 13. EMAIL / RESEND (Alternative to SendGrid)
# ============================================================
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ============================================================
# 14. ANALYTICS & MONITORING
# ============================================================
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"  # Google Analytics

# ============================================================
# 15. FEATURE FLAGS
# ============================================================
NEXT_PUBLIC_ENABLE_AI_ASSISTANT="true"
NEXT_PUBLIC_ENABLE_BLOCKCHAIN="true"
NEXT_PUBLIC_ENABLE_MAPS="true"
NEXT_PUBLIC_ENABLE_MAINTENANCE_MODE="false"

# ============================================================
# 16. APPLICATION URL
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Encryption
ENCRYPTION_KEY="your-encryption-key-here"